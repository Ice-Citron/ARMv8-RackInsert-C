#include "dp.h"

static uint64_t mask_from_sf(uint32_t sf) {
    return sf == 0 ? UINT32_MAX : UINT64_MAX;
}

static uint64_t read_dp_register(uint32_t reg) {
    return reg == 31 ? zeroRegister : registers[reg];
}

static void write_dp_result(uint32_t rd, uint32_t sf, uint64_t entry) {
    if (rd == 31) {
        return;
    }

    if (sf == 0) {
        registers[rd] = (registers[rd] & 0xffffffff00000000ULL)
                      | (entry & UINT32_MAX);
    } else {
        registers[rd] = entry;
    }
}

static uint64_t shift_operand(uint64_t operand, uint32_t shift_type,
                              uint32_t shift_dist, uint32_t sf) {
    uint64_t mask = mask_from_sf(sf);
    uint32_t width = sf == 0 ? 32 : 64;

    operand &= mask;
    if (shift_dist == 0) {
        return operand;
    }

    if (shift_type == 0) {
        return (operand << shift_dist) & mask;
    }
    if (shift_type == 1) {
        return operand >> shift_dist;
    }
    if (shift_type == 2) {
        if (sf == 0) {
            return (uint32_t)((int32_t)operand >> shift_dist);
        }
        return (uint64_t)((int64_t)operand >> shift_dist);
    }

    shift_dist %= width;
    if (shift_dist == 0) {
        return operand;
    }
    return ((operand >> shift_dist) | (operand << (width - shift_dist))) & mask;
}

static void set_logic_flags(uint64_t entry, uint32_t sf) {
    uint64_t masked = entry & mask_from_sf(sf);

    pState.n = sf == 0 ? sign32(masked) : sign64(masked);
    pState.z = masked == 0;
    pState.c = false;
    pState.v = false;
}

void dpreg(uint32_t instr) {
    pState = (state){false, false, false, false};

    uint32_t sf_dpreg = bitmask_check(31, 31, instr);
    uint32_t opc_dpreg = bitmask_check(30, 29, instr);
    uint32_t m_dpreg = bitmask_check(28, 28, instr);
    uint32_t rd_index = bitmask_check(4, 0, instr);
    uint32_t rn_index = bitmask_check(9, 5, instr);
    uint32_t rm_index = bitmask_check(20, 16, instr);
    uint64_t mask = mask_from_sf(sf_dpreg);
    uint64_t rn = read_dp_register(rn_index) & mask;
    uint64_t rm = read_dp_register(rm_index) & mask;
    uint64_t entry = 0;

    if (m_dpreg == 1) {
        uint32_t ra_index = bitmask_check(14, 10, instr);
        uint32_t x_mult = bitmask_check(15, 15, instr);
        uint64_t ra_mult = read_dp_register(ra_index) & mask;
        uint64_t product = (rn * rm) & mask;

        if (x_mult == 0) {
            entry = (ra_mult + product) & mask;
        } else {
            entry = (ra_mult - product) & mask;
        }

        write_dp_result(rd_index, sf_dpreg, entry);
    } else {
        uint32_t opr0 = bitmask_check(24, 24, instr);
        uint32_t shift_type = bitmask_check(23, 22, instr);
        uint32_t shift_dist = bitmask_check(15, 10, instr);
        uint64_t operand2 = shift_operand(rm, shift_type, shift_dist, sf_dpreg);

        if (opr0 == 1) {
            if (opc_dpreg < 2) {
                entry = (rn + operand2) & mask;
                if (opc_dpreg == 1) {
                    if (sf_dpreg == 0) {
                        add32flags(rn_index, entry, &pState, operand2);
                    } else {
                        add64flags(rn_index, entry, &pState, operand2);
                    }
                }
            } else {
                entry = (rn - operand2) & mask;
                if (opc_dpreg == 3) {
                    if (sf_dpreg == 0) {
                        sub32flags(rn_index, entry, &pState, operand2);
                    } else {
                        sub64flags(rn_index, entry, &pState, operand2);
                    }
                }
            }
        } else {
            if (bitmask_check(21, 21, instr) == 1) {
                operand2 = ~operand2 & mask;
            }

            switch (opc_dpreg) {
                case 0:
                    entry = rn & operand2;
                    break;
                case 1:
                    entry = rn | operand2;
                    break;
                case 2:
                    entry = rn ^ operand2;
                    break;
                default:
                    entry = rn & operand2;
                    set_logic_flags(entry, sf_dpreg);
                    break;
            }
        }

        write_dp_result(rd_index, sf_dpreg, entry);
    }
}
